@時間制御繰り返し往復(秒)
--information:時間制御繰り返し往復(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\繰り返し
--require:2004200
--twopoint
--param:周期(秒),0.5
--param:周期ずれ%,0
--timecontrol
local gp = obj.getpoint;
local T1 = gp("time", 1);
local t, T, d = gp("time"), gp("param");
if 1 / T < 0 then t, T = t - T1 - 1 / gp("framerate"), -T end
if T == 0 then T = 1 end
local v0, v1 = gp(0), gp(1);
local x = 2 * ((t / T + d / 100) % 1);
if x >= 1 then v0, v1, x = v1, v0, x - 1 end
return v0 + (v1 - v0) * gp("timecontrol", "value", x * T1);

