if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local rho = t ^ 4;

return v0 + (v1 - v0) * rho;

@N次式
--information:N次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
--param:次数N,5
local gp, math = obj.getpoint, math;
local i, t = math.modf(gp("index"));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local N = math.max(gp("param"), 0);
local rho = (N > 0 or t > 0) and t ^ N or 0;

return v0 + (v1 - v0) * rho;

@指数関数
--information:指数関数@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
--param:減衰率,2
local gp, math = obj.getpoint, math;
local i, t = math.modf(gp("index"));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local a = math.max(gp("param"), 0);
local rho = a > 0 and (math.exp(a * t) - 1) / (math.exp(a) - 1) or t;

return v0 + (v1 - v0) * rho;

@円形
--information:円形@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local gp, math = obj.getpoint, math;
local i, t = math.modf(gp("index"));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local rho = 1 - (1 - t ^ 2) ^ 0.5;

return v0 + (v1 - v0) * rho;

@等速移動(秒)
--information:等速移動(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--twopoint
--param:単位時間(秒),1
local gp = obj.getpoint;
local t, T, v0, v1 = gp("time"), gp("param"), gp(0), gp(1);
if 1 / T < 0 then t, T, v0, v1 = gp("time", 1) - t, -T, v1, v0 end
if T == 0 then T = 1 end
return v0 + (v1 - v0) * t / T;

@等速移動(フレーム)
--information:等速移動(フレーム)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--twopoint
--param:単位時間(フレーム),60
local gp = obj.getpoint;
local fr = gp("framerate");
local f, F, v0, v1 = fr * gp("time"), gp("param"), gp(0), gp(1);
if 1 / F < 0 then f, F, v0, v1 = fr * gp("time", 1) - f, -F, v1, v0 end
if F == 0 then F = 1 end
return v0 + (v1 - v0) * f / F;

@コマ落ち反復(秒)
--information:コマ落ち反復(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(秒),0.5
--param:周期ずれ%,0
--param:デューティ比%,50
local gp = obj.getpoint;
local t, T, d, R = gp("time"), gp("param");
if 1 / T < 0 then t, T = t - gp("time", 1) - 1 / gp("framerate"), -T end
if T == 0 then T = 1 end
return gp(((t / T + d / 100) % 1) < math.min(math.max(R / 100, 0), 1) and 0 or 1);

@コマ落ち反復(フレーム)
--information:コマ落ち反復(フレーム)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(フレーム),30
--param:周期ずれ%,0
--param:デューティ比%,50
local gp = obj.getpoint;
local fr = gp("framerate");
local f, F, d, R = fr * gp("time"), gp("param");
if 1 / F < 0 then f, F = f - fr * gp("time", 1) - 1, -F end
if F == 0 then F = 1 end
return gp(((f / F + d / 100) % 1) < math.min(math.max(R / 100, 0), 1) and 0 or 1);

@コマ落ち反復(Hz)
--information:コマ落ち反復(Hz)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(Hz),2
--param:周期ずれ%,0
--param:デューティ比%,50
local gp = obj.getpoint;
local t, N, d, R = gp("time"), gp("param");
if 1 / N < 0 then t, N = t - gp("time", 1) - 1 / gp("framerate"), -N end
return gp(((t * N + d / 100) % 1) < math.min(math.max(R / 100, 0), 1) and 0 or 1);

@コマ落ち反復(BPM)
--information:コマ落ち反復(BPM)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(BPM),120
--param:周期ずれ%,0
--param:デューティ比%,50
local gp = obj.getpoint;
local t, N, d, R = gp("time"), gp("param");
if 1 / N < 0 then t, N = t - gp("time", 1) - 1 / gp("framerate"), -N end
return gp(((t * N / 60 + d / 100) % 1) < math.min(math.max(R / 100, 0), 1) and 0 or 1);

@コマ落ち反復(BPMグリッド)
--information:コマ落ち反復(BPMグリッド)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(音符数),1
--param:基準のN分音符(0:小節),4
--param:グリッド1拍のN分音符,4
--param:周期ずれ%,0
--param:デューティ比%,50
local math, gp, tempo, beats = math, obj.getpoint, obj.getinfo("bpm");
local t, p, n, N, d, R = gp("time"), gp("param");
n, N = math.max(n, 0), math.max(N, 1);
if 1 / p < 0 then t, p = t - gp("time", 1) - 1 / gp("framerate"), -p end
if n == 0 then n, N = 1, beats end
return gp(((t * tempo * n / (60 * p * N) + d / 100) % 1) < math.min(math.max(R / 100, 0), 1) and 0 or 1);

@コマ落ちランダム(秒)
--information:コマ落ちランダム(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(秒),0.5
--param:周期ずれ%,0
local gp = obj.getpoint;
local t, T, d = gp("time"), gp("param");
if 1 / T < 0 then t = t - gp("time", 1) - 1 / gp("framerate") end
if T == 0 then T = 1 end
local v0, v1 = gp(0), gp(1);
return v0 + (v1 - v0) * rand1(2525, math.floor(t / T + d / 100) + 1);

@コマ落ちランダム(フレーム)
--information:コマ落ちランダム(フレーム)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(フレーム),30
--param:周期ずれ%,0
local gp = obj.getpoint;
local fr = gp("framerate");
local f, F, d = fr * gp("time"), gp("param");
if 1 / F < 0 then f = f - fr * gp("time", 1) - 1 end
if F == 0 then F = 1 end
local v0, v1 = gp(0), gp(1);
return v0 + (v1 - v0) * rand1(2525, math.floor(f / F + d / 100) + 1);

@コマ落ちランダム(Hz)
