--param:周期ずれ%,0
--timecontrol
local gp = obj.getpoint;
local T1 = gp("time", 1);
local t, T, d = gp("time"), gp("param");
if 1 / T < 0 then t, T = t - T1 - 1 / gp("framerate"), -T end
if T == 0 then T = 1 end
local v0, v1 = gp(0), gp(1);
return v0 + (v1 - v0) * gp("timecontrol", "value", ((t / T + d / 100) % 1) * T1);

