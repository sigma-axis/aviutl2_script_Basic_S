elseif i < 0 then i, t = 0, 0 end
local v0, v1, O = gp(i), gp(i + 1), gp("param");
v0, v1 = v0 - O, v1 - O;
if v0 == 0 or v1 == 0 or (v0 > 0) ~= (v1 > 0) then
	-- fall back to the linear interpolation instead.
	return v0 + (v1 - v0) * t + O;
end
return v0 * (v1 / v0) ^ t + O;

