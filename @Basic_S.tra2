@全体で時間制御
--information:全体で時間制御@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--timecontrol
local i, t = require("Basic_S").track.curve.entire();
local v0, v1 = obj.getpoint(i), obj.getpoint(i + 1)
return v0 + (v1 - v0) * t;

@区間ごとに時間制御
--information:区間ごとに時間制御@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--timecontrol
local i, t = require("Basic_S").track.curve.section();
local v0, v1 = obj.getpoint(i), obj.getpoint(i + 1)
return v0 + (v1 - v0) * t;

@全体で時間制御(回転)
--information:全体で時間制御(回転)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--param:1周角度,360
--timecontrol
local track = require("Basic_S").track;
return track.linear_rotation(track.curve.entire())

@区間ごとに時間制御(回転)
--information:区間ごとに時間制御(回転)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--param:1周角度,360
--timecontrol
local track = require("Basic_S").track;
return track.linear_rotation(track.curve.section())

@正弦波
--information:正弦波@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = 1 - math.cos(math.pi / 2 * t);
return v0 + (v1 - v0) * rho;

@2次式
--information:2次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 2;
return v0 + (v1 - v0) * rho;

@3次式
--information:3次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 3;
return v0 + (v1 - v0) * rho;

@4次式
--information:4次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 4;
return v0 + (v1 - v0) * rho;

@N次式
--information:N次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
--param:次数N,5
local t, v0, v1 = require("Basic_S").track.ease_inout_core();

local N = math.max(obj.getpoint("param"), 0);
local rho = (N > 0 or t > 0) and t ^ N or 0;

return v0 + (v1 - v0) * rho;

@指数関数
--information:指数関数@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
--param:減衰率,2
local t, v0, v1 = require("Basic_S").track.ease_inout_core();

local a = math.max(obj.getpoint("param"), 0);
local rho = a > 0 and (math.exp(a * t) - 1) / (math.exp(a) - 1) or t;

return v0 + (v1 - v0) * rho;

@円形
--information:円形@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = 1 - (1 - t ^ 2) ^ 0.5;
return v0 + (v1 - v0) * rho;

@等速移動(秒)
--information:等速移動(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--twopoint
--param:単位時間(秒),1
local gp = obj.getpoint;
local t, T, v0, v1 = gp("time"), gp("param"), gp(0), gp(1);
if 1 / T < 0 then t, T, v0, v1 = gp("time", 1) - t, -T, v1, v0 end
if T == 0 then T = 1 end
return v0 + (v1 - v0) * t / T;

@等速移動(フレーム)
--information:等速移動(フレーム)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--twopoint
--param:単位時間(フレーム),60
local gp = obj.getpoint;
local fr = gp("framerate");
local f, F, v0, v1 = fr * gp("time"), gp("param"), gp(0), gp(1);
if 1 / F < 0 then f, F, v0, v1 = fr * gp("time", 1) - f, -F, v1, v0 end
if F == 0 then F = 1 end
return v0 + (v1 - v0) * f / F;

@コマ落ち反復(秒)
--information:コマ落ち反復(秒)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\コマ落ち
--require:2004200
--twopoint
--param:周期(秒),0.5
--param:周期ずれ%,0
--param:デューティ比%,50
local track = require("Basic_S").track;
return track.discrete_repeat(track.period.sec(obj.getpoint("param")))

