--group:その他,false
--value@PI:PI,{}
local obj, math, type, tonumber = obj, math, type, tonumber;
local basic_s = require("Basic_S");

-- set anchors.
if #text > 0 then
	obj.setanchor("X,Y", 0, "line");
end

-- take parameters.
--[==[
	PI = {
		text:			string?,
		font_size:		number?,
		font_name:		string?,
		color_main:		number?,
		color_sub:		number?,
		type_char:		string?,
