@対数補間
--information:対数補間@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\特殊補間
--require:2004200
--param:原点,0
--timecontrol
local gp, math = obj.getpoint, math;
local n, i, t = gp("num"), math.modf(gp("index"));
if i >= n - 1 then i, t = n - 2, 1 end
t = gp("timecontrol", "value", t * gp("time", n - 1));
local v0, v1, O = gp(i), gp(i + 1), gp("param");
v0, v1 = v0 - O, v1 - O;
if v0 == 0 or v1 == 0 or (v0 > 0) ~= (v1 > 0) then
	-- fall back to the linear interpolation instead.
	return v0 + (v1 - v0) * t + O;
end
return v0 * (v1 / v0) ^ t + O;

@対数補間(全体時間制御)
--information:対数補間(全体時間制御)@Basic_S v2.10 (for beta43b) by σ軸
