@全体で時間制御
--information:全体で時間制御@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--timecontrol
local gp = obj.getpoint;
local n, i, t = gp("num"), math.modf(gp("timecontrol", "index"));
if i >= n - 1 then i, t = n - 2, 1;
elseif i < 0 then i, t = 0, 0 end
local v0, v1 = gp(i), gp(i + 1);
return v0 + (v1 - v0) * t;

@区間ごとに時間制御
--information:区間ごとに時間制御@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--timecontrol
local gp = obj.getpoint;
local n, i, t = gp("num"), math.modf(gp("index"));
if i >= n - 1 then i, t = n - 2, 1 end
t = gp("timecontrol", "value", t * gp("time", n - 1));
local v0, v1 = gp(i), gp(i + 1);
return v0 + (v1 - v0) * t;

@全体で時間制御(回転)
--information:全体で時間制御(回転)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--param:1周角度,360
--timecontrol
local gp, math = obj.getpoint, math;
local n, i, t = gp("num"), math.modf(gp("timecontrol", "index"));
if i >= n - 1 then i, t = n - 2, 1;
elseif i < 0 then i, t = 0, 0 end
local k, l = gp("link");
if l == 3 then
	local cycle = gp("param");

	-- calculate two quaternions.
	local cos, sin, atan2, r = math.cos, math.sin, math.atan2, 2 * math.pi / cycle;
	local cx1, cy1, cz1, cx2, cy2, cz2, sx1, sy1, sz1, sx2, sy2, sz2 do local
		A = r * (gp(i    ,    -k) % cycle) / 2; cx1, sx1 = cos(A), sin(A);
		A = r * (gp(i    , 1 - k) % cycle) / 2; cy1, sy1 = cos(A), sin(A);
		A = r * (gp(i    , 2 - k) % cycle) / 2; cz1, sz1 = cos(A), sin(A);
		A = r * (gp(i + 1,    -k) % cycle) / 2; cx2, sx2 = cos(A), sin(A);
		A = r * (gp(i + 1, 1 - k) % cycle) / 2; cy2, sy2 = cos(A), sin(A);
		A = r * (gp(i + 1, 2 - k) % cycle) / 2; cz2, sz2 = cos(A), sin(A);
	end
	local q1r, q1i, q1j, q1k, q2r, q2i, q2j, q2k =
		-- (c_x + i s_x) x (c_y + j s_y).
		cx1 * cy1, sx1 * cy1, cx1 * sy1, sx1 * sy1,
		cx2 * cy2, sx2 * cy2, cx2 * sy2, sx2 * sy2;
	q1r, q1i, q1j, q1k, q2r, q2i, q2j, q2k =
		-- x (c_z + k s_z).
		q1r * cz1 - q1k * sz1,
		q1i * cz1 + q1j * sz1,
		q1j * cz1 - q1i * sz1,
		q1k * cz1 + q1r * sz1,

		q2r * cz2 - q2k * sz2,
		q2i * cz2 + q2j * sz2,
		q2j * cz2 - q2i * sz2,
		q2k * cz2 + q2r * sz2;

	-- calculate q2' = q2 q1^-1.
	q2r, q2i, q2j, q2k =
		 q2r * q1r + q2i * q1i + q2j * q1j + q2k * q1k,
		-q2r * q1i + q2i * q1r - q2j * q1k + q2k * q1j,
		-q2r * q1j + q2i * q1k + q2j * q1r - q2k * q1i,
		-q2r * q1k - q2i * q1j + q2j * q1i + q2k * q1r;
	if q2r < 0 then q2r, q2i, q2j, q2k = -q2r, -q2i, -q2j, -q2k end

	-- calculate q2'' = q2'^t = exp(t log(q2')).
	local a = (q2i ^ 2 + q2j ^ 2 + q2k ^ 2) ^ 0.5;
	if a > 0 then
		local A = t * atan2(a, q2r);
		q2r, A = cos(A), sin(A);
		q2i, q2j, q2k = A * q2i / a, A * q2j / a, A * q2k / a;
	else return gp(i, 0) end

	-- calculate q = q2'' q1.
	q1r, q1i, q1j, q1k =
		q2r * q1r - q2i * q1i - q2j * q1j - q2k * q1k,
		q2r * q1i + q2i * q1r + q2j * q1k - q2k * q1j,
		q2r * q1j - q2i * q1k + q2j * q1r + q2k * q1i,
		q2r * q1k + q2i * q1j - q2j * q1i + q2k * q1r;

	-- determine the euler angles.
	-- cf.) https://github.com/sigma-axis/sigma_aviutl_scripts/blob/79bce1098a69b1e8da7cb77811aa3356a411ee2d/sigma_rot_helper.lua#L80-L94
	a = atan2(
		2 * (q1r * q1i - q1j * q1k),
		q1r ^ 2 - q1i ^ 2 - q1j ^ 2 + q1k ^ 2);
	if k > 0 then
		cx1, sx1 = cos(a / 2), sin(a / 2);
		q1r, q1i, q1j, q1k = -- (c - i s) x q
			cx1 * q1r + sx1 * q1i,
			cx1 * q1i - sx1 * q1r,
			cx1 * q1j + sx1 * q1k,
			cx1 * q1k - sx1 * q1j;
		if k > 1 then q1j, q1k = q1k, q1j end
		if q1r ^ 2 + q1j ^ 2 < q1k ^ 2 + q1i ^ 2 then q1r, q1j = q1k, q1i end
		if q1r < 0 then q1r, q1j = -q1r, -q1j end
		a = 2 * atan2(q1j, q1r);
	end
	return a / r;
end
local v0, v1 = gp(i), gp(i + 1);
return v0 + (v1 - v0) * t;

@区間ごとに時間制御(回転)
--information:区間ごとに時間制御(回転)@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--param:1周角度,360
--timecontrol
local gp, math = obj.getpoint, math;
local n, i, t = gp("num"), math.modf(gp("index"));
if i >= n - 1 then i, t = n - 2, 1 end
t = gp("timecontrol", "value", t * gp("time", n - 1));
local k, l = gp("link");
if l == 3 then
	local cycle = gp("param");

	-- calculate two quaternions.
	local cos, sin, atan2, r = math.cos, math.sin, math.atan2, 2 * math.pi / cycle;
	local cx1, cy1, cz1, cx2, cy2, cz2, sx1, sy1, sz1, sx2, sy2, sz2 do local
		A = r * (gp(i    ,    -k) % cycle) / 2; cx1, sx1 = cos(A), sin(A);
		A = r * (gp(i    , 1 - k) % cycle) / 2; cy1, sy1 = cos(A), sin(A);
		A = r * (gp(i    , 2 - k) % cycle) / 2; cz1, sz1 = cos(A), sin(A);
		A = r * (gp(i + 1,    -k) % cycle) / 2; cx2, sx2 = cos(A), sin(A);
		A = r * (gp(i + 1, 1 - k) % cycle) / 2; cy2, sy2 = cos(A), sin(A);
		A = r * (gp(i + 1, 2 - k) % cycle) / 2; cz2, sz2 = cos(A), sin(A);
	end
	local q1r, q1i, q1j, q1k, q2r, q2i, q2j, q2k =
		-- (c_x + i s_x) x (c_y + j s_y).
		cx1 * cy1, sx1 * cy1, cx1 * sy1, sx1 * sy1,
		cx2 * cy2, sx2 * cy2, cx2 * sy2, sx2 * sy2;
	q1r, q1i, q1j, q1k, q2r, q2i, q2j, q2k =
		-- x (c_z + k s_z).
		q1r * cz1 - q1k * sz1,
		q1i * cz1 + q1j * sz1,
		q1j * cz1 - q1i * sz1,
		q1k * cz1 + q1r * sz1,

		q2r * cz2 - q2k * sz2,
		q2i * cz2 + q2j * sz2,
		q2j * cz2 - q2i * sz2,
		q2k * cz2 + q2r * sz2;

	-- calculate q2' = q2 q1^-1.
	q2r, q2i, q2j, q2k =
		 q2r * q1r + q2i * q1i + q2j * q1j + q2k * q1k,
		-q2r * q1i + q2i * q1r - q2j * q1k + q2k * q1j,
		-q2r * q1j + q2i * q1k + q2j * q1r - q2k * q1i,
		-q2r * q1k - q2i * q1j + q2j * q1i + q2k * q1r;
	if q2r < 0 then q2r, q2i, q2j, q2k = -q2r, -q2i, -q2j, -q2k end

	-- calculate q2'' = q2'^t = exp(t log(q2')).
	local a = (q2i ^ 2 + q2j ^ 2 + q2k ^ 2) ^ 0.5;
	if a > 0 then
		local A = t * atan2(a, q2r);
		q2r, A = cos(A), sin(A);
		q2i, q2j, q2k = A * q2i / a, A * q2j / a, A * q2k / a;
	else return gp(i, 0) end

	-- calculate q = q2'' q1.
	q1r, q1i, q1j, q1k =
		q2r * q1r - q2i * q1i - q2j * q1j - q2k * q1k,
		q2r * q1i + q2i * q1r + q2j * q1k - q2k * q1j,
		q2r * q1j - q2i * q1k + q2j * q1r + q2k * q1i,
		q2r * q1k + q2i * q1j - q2j * q1i + q2k * q1r;

	-- determine the euler angles.
	-- cf.) https://github.com/sigma-axis/sigma_aviutl_scripts/blob/79bce1098a69b1e8da7cb77811aa3356a411ee2d/sigma_rot_helper.lua#L80-L94
	a = atan2(
		2 * (q1r * q1i - q1j * q1k),
		q1r ^ 2 - q1i ^ 2 - q1j ^ 2 + q1k ^ 2);
	if k > 0 then
		cx1, sx1 = cos(a / 2), sin(a / 2);
		q1r, q1i, q1j, q1k = -- (c - i s) x q
			cx1 * q1r + sx1 * q1i,
			cx1 * q1i - sx1 * q1r,
			cx1 * q1j + sx1 * q1k,
			cx1 * q1k - sx1 * q1j;
		if k > 1 then q1j, q1k = q1k, q1j end
		if q1r ^ 2 + q1j ^ 2 < q1k ^ 2 + q1i ^ 2 then q1r, q1j = q1k, q1i end
		if q1r < 0 then q1r, q1j = -q1r, -q1j end
		a = 2 * atan2(q1j, q1r);
	end
	return a / r;
end
local v0, v1 = gp(i), gp(i + 1);
return v0 + (v1 - v0) * t;

@正弦波
--information:正弦波@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local gp, math = obj.getpoint, math;
local i, t = math.modf(gp("index"));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local rho = 1 - math.cos(math.pi / 2 * t);

return v0 + (v1 - v0) * rho;

@2次式
--information:2次式@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\基本緩急
--require:2004200
--speed:0,1
local gp, math = obj.getpoint, math;
local i, t = math.modf(gp("index"));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local rho = t ^ 2;

return v0 + (v1 - v0) * rho;

