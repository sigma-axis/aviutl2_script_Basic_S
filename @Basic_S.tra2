local t, N, d = gp("time"), gp("param");
if 1 / N < 0 then t = t - gp("time", 1) - 1 / gp("framerate") end
local v0, v1 = gp(0), gp(1);
return v0 + (v1 - v0) * rand1(2525, math.floor(t * N + d / 100) + 1);

