if v0 == 0 or v1 == 0 or (v0 > 0) ~= (v1 > 0) then
	-- fall back to the linear interpolation instead.
	return v0 + (v1 - v0) * t + O;
end
return 1 / (1 / v0 + (1 / v1 - 1 / v0) * t) + O;

