@バウンス
--information:バウンス@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--speed:0,1
--param:反発係数,0.70710678
--param:回数,0
--timecontrol
local gp, basic_s = obj.getpoint, require("Basic_S");
local i, t = basic_s.track.curve.section();
local v0, v1 = gp(i), gp(i + 1);
t, v0, v1 = basic_s.reduce_inout_ease(t, v0, v1, gp("accelerate"), gp("decelerate"));
return basic_s.track.bounce(t, v0, v1, gp("param"));

