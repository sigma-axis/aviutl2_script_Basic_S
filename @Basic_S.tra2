@対数補間
--information:対数補間@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S\特殊補間
--require:2004200
--param:原点,0
--timecontrol
local gp, track = obj.getpoint, require("Basic_S").track;
local i, t = track.curve.section();
return track.logarithmic(t, gp(i), gp(i + 1), gp("param"))

@対数補間(全体時間制御)
--information:対数補間(全体時間制御)@Basic_S v2.10 (for beta43b) by σ軸
