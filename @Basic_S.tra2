@バネ振動
--information:バネ振動@Basic_S v2.10 (for beta43b) by σ軸
--label:Basic_S
--require:2004200
--speed:0,1
--param:振動回数,3
--param:減衰率,0.3
--timecontrol
local gp, math = obj.getpoint, math;
local n, i, t = gp("num"), math.modf(gp("index"));
if i >= n - 1 then i, t = n - 2, 1 end
t = gp("timecontrol", "value", t * gp("time", n - 1));
local v0, v1, sp0, sp1 = gp(i), gp(i + 1), gp("accelerate"), gp("decelerate");
if sp0 == sp1 then
	if t < 0.5 then t, v1, sp1 = 2 * t, (v0 + v1) / 2, not sp1;
	else t, v0 = 2 * t - 1, (v0 + v1) / 2 end
end
if sp1 then v0, v1, t = v1, v0, 1 - t end

local n, r = gp("param");
n = math.max(n, 0);
r = math.max(r, 0);
r = (r > 0 or t < 1) and (r >= 1 and t or (r ^ (1 - t) - r) / (1 - r)) or 1;
local rho = r * math.sin(2 * math.pi * ((n + 0.25) * (1 - t) + 0.25));

return v0 + (v1 - v0) * rho;

