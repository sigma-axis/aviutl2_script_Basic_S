--param:グリッド1拍のN分音符,4
--param:周期ずれ%,0
local math, gp, tempo, beats = math, obj.getpoint, obj.getinfo("bpm");
local t, p, n, N, d = gp("time"), gp("param");
n, N = math.max(n, 0), math.max(N, 1);
if 1 / p < 0 then t, p = t - gp("time", 1) - 1 / gp("framerate"), -p end
if n == 0 then n, N = 1, beats end
local v0, v1 = gp(0), gp(1);
return v0 + (v1 - v0) * rand1(2525, math.floor(t * tempo * n / (60 * p * N) + d / 100) + 1);

@時間制御繰り返し(秒)
--information:時間制御繰り返し(秒)@Basic_S v2.10 (for beta43b) by σ軸
